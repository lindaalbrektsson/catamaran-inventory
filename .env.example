# Copy this file to .env.local. Both values come from Supabase Project Settings > API.
# Public credentials only. NEVER put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Smart Scan: SERVER ONLY. Enable after applying the Smart Scan migration.
# Enter an OpenAI project API key directly in your local/Vercel environment.
SMART_SCAN_ENABLED=false
OPENAI_API_KEY=
# Use an available vision model with Responses API structured-output support.
SMART_SCAN_MODEL=
