# Copy this file to .env.local. Both values come from Supabase Project Settings > API.
# Browser configuration uses public credentials only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, SERVER ONLY. Add manually in Vercel; never prefix with NEXT_PUBLIC_.
# Supabase Project Settings > API Keys > dedicated secret key. Never commit a value.
SUPABASE_AUTH_ADMIN_KEY=

# Server-only feature gate. Enable only after configuring Supabase SMS delivery.
SMS_RECOVERY_ENABLED=false

# Smart Scan: SERVER ONLY. Enable after applying the Smart Scan migration.
# Enter an OpenAI project API key directly in your local/Vercel environment.
SMART_SCAN_ENABLED=false
OPENAI_API_KEY=
# Use an available vision model with Responses API structured-output support.
SMART_SCAN_MODEL=
