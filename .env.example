# Copy this file to .env.local. Both values come from Supabase Project Settings > API.
# Browser configuration uses public credentials only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, SERVER ONLY. Add manually in Vercel; never prefix with NEXT_PUBLIC_.
# Supabase Project Settings > API Keys > dedicated secret key. Never commit a value.
SUPABASE_AUTH_ADMIN_KEY=

# Optional SERVER ONLY diagnostics: static operation + duration + outcome; no user data.
# Leave off normally. See docs/PERFORMANCE-REVIEW.md before enabling.
PERFORMANCE_LOGGING=0

# SERVER ONLY: domain for opaque internal Auth identities.
AUTH_INTERNAL_EMAIL_DOMAIN=auth.catamaranbelize.com

# Web Push: server-only VAPID configuration. Public key alone is passed to opt-in UI.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# Shared only with Supabase Vault's scheduled dispatcher.
PUSH_CRON_SECRET=
